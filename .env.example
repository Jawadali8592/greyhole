# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Base URL of the Video Downloader API (backend).
# Leave unset to use the production default baked into src/lib/api.ts.
# For local development against the FastAPI backend:
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=https://api.greyhole.live

